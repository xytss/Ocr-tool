<Window x:Class="OcrTool.App.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 结果"
        Width="1040"
        Height="660"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="15"
        Foreground="#17211F"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#24312E" />
            <Setter Property="BorderBrush" Value="#CDD6D3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#0D9488" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0D9488" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE4E2" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OCR 结果" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               Text="正在识别…"
                               Foreground="#52615D"
                               FontSize="14" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="#52615D"
                           FontSize="14"
                           Text="Ctrl+Enter 复制并关闭" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44*" MinWidth="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="56*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#E8EEEC"
                    BorderBrush="#D1DAD7"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Image x:Name="ScreenshotImage"
                           Margin="12"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="8,4"
                            Background="#D917211F"
                            CornerRadius="4">
                        <TextBlock Text="原图" Foreground="White" FontSize="14" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D1DAD7"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBox x:Name="ResultTextBox"
                             Margin="16"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Microsoft YaHei UI"
                             FontSize="18"
                             IsReadOnly="True"
                             SpellCheck.IsEnabled="False"
                             TextChanged="ResultTextBox_TextChanged" />
                    <TextBlock x:Name="EmptyText"
                               Margin="18"
                               VerticalAlignment="Top"
                               Text="正在识别，请稍候…"
                               Foreground="#667570"
                               FontSize="14"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE4E2" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                <Button Content="关闭"
                        Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click" />
                <Button x:Name="CopyButton"
                        Margin="10,0,0,0"
                        Content="复制文字"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}"
                        Click="CopyButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
