<Window x:Class="OcrTool.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 设置"
        Width="560"
        Height="510"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="15"
        Foreground="#17211F"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#24312E" />
            <Setter Property="BorderBrush" Value="#CDD6D3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#0D9488" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0D9488" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE4E2" BorderThickness="0,0,0,1">
            <StackPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0" Text="快捷键、识别行为与系统启动设置" Foreground="#52615D" FontSize="14" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,22">
            <TextBlock Text="截图快捷键" FontSize="16" FontWeight="SemiBold" />
            <Button x:Name="HotkeyButton"
                    Margin="0,10,0,0"
                    Height="44"
                    HorizontalContentAlignment="Left"
                    Padding="14,0"
                    Background="White"
                    BorderBrush="#BFCBC7"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="HotkeyButton_Click" />
            <TextBlock x:Name="HotkeyHint"
                       Margin="2,7,0,0"
                       Text="点击后，直接按下新的组合键。"
                       Foreground="#5A6965"
                       FontSize="14" />

            <Border Margin="0,24,0,0" BorderBrush="#DDE4E2" BorderThickness="0,1,0,0" />
            <TextBlock Margin="0,20,0,0" Text="识别与启动行为" FontSize="16" FontWeight="SemiBold" />
            <CheckBox x:Name="ShowResultCheckBox"
                      Margin="0,14,0,0"
                      Content="识别后显示原图和可编辑文字窗口"
                      FontSize="16" />
            <CheckBox x:Name="AutoCopyCheckBox"
                      Margin="0,14,0,0"
                      Content="识别成功后自动复制到剪贴板"
                      FontSize="16" />
            <CheckBox x:Name="StartWithWindowsCheckBox"
                      Margin="0,14,0,0"
                      Content="登录 Windows 后自动启动（当前用户）"
                      FontSize="16" />
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE4E2" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                <Button Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}" />
                <Button Margin="10,0,0,0"
                        Content="保存"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
