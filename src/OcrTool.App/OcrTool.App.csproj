<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\OcrTool.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>OCR 工具</Product>
    <Company>OCR Tool</Company>
    <Description>使用 PP-OCRv6 small 的本地截图 OCR 工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcrTool.Core\OcrTool.Core.csproj" />
    <ProjectReference Include="..\OcrTool.Engine\OcrTool.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OcrTool.IntegrationTests" />
  </ItemGroup>

</Project>
